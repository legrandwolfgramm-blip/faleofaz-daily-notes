# Copy this to .env for local development
# On Railway, set these as environment variables in the dashboard

# Required: Secret key for signing JWT session tokens
# Generate a strong random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# Admin account initial password (set on first boot, can be changed in-app)
ADMIN_PASSWORD=1801

# Path to SQLite database file
# On Railway, use /data/faleofaz.db (persistent volume)
DATABASE_PATH=/data/faleofaz.db

# Server port
PORT=5000

# Node environment
NODE_ENV=production
